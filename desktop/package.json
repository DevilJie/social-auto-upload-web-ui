{
  "name": "qianfan-sync-desktop",
  "version": "1.3.0",
  "private": true,
  "description": "千帆云递 · 桌面客户端（P0 骨架）",
  "main": "dist/main/index.js",
  "scripts": {
    "build:renderer": "cd ../frontend && npm run build",
    "build:main": "tsc",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "tsc -w & electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder -mwl"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}
